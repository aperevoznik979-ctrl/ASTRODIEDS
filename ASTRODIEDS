  <!-- ==================== JAVASCRIPT (ЗАДАЧА 2 + ИНТЕРАКТИВ) ==================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toast = document.getElementById('order-toast');
      const cartCountEl = document.getElementById('cart-count');
      const tourSelect = document.getElementById('tour-select');
      const cartButtons = document.querySelectorAll('.menu-card .add-to-cart-btn');
      let cartItemsCount = 0;
      let toastTimer = null;

      // Функция показа уведомления
      function showNotification(message) {
        toast.textContent = message;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('show');
        }, 3500);
      }

      // Задача 2: Обработчик клика на кнопки «В корзину» внутри карточек .menu-card
      cartButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const card = button.closest('.menu-card');
          const titleEl = card ? card.querySelector('.tour-card__title') : null;
          const itemName = titleEl ? titleEl.textContent.trim() : 'Выбранный маршрут';
          const tourValue = button.getAttribute('data-tour');

          // Увеличиваем счётчик корзины в шапке
          cartItemsCount += 1;
          if (cartCountEl) {
            cartCountEl.textContent = cartItemsCount;
          }

          // Автоматически подставляем выбранную позицию в форму бронирования
          if (tourSelect && tourValue) {
            tourSelect.value = tourValue;
          }

          // Выводим уведомление о добавлении маршрута и комплиментарного напитка в заказ
          const notificationText = `✅ «${itemName}» и согревающий напиток добавлены в ваш заказ!`;
          showNotification(notificationText);
        });
      });

      // Мобильное меню (бургер)
      const burgerBtn = document.getElementById('burger-btn');
      const mainNav = document.getElementById('main-nav');

      if (burgerBtn && mainNav) {
        burgerBtn.addEventListener('click', () => {
          const isOpen = mainNav.classList.toggle('open');
          burgerBtn.setAttribute('aria-expanded', String(isOpen));
        });

        mainNav.querySelectorAll('.nav__link').forEach((link) => {
          link.addEventListener('click', () => {
            mainNav.classList.remove('open');
            burgerBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // Обработка отправки формы бронирования
      const bookingForm = document.getElementById('booking-form');
      if (bookingForm) {
        bookingForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const guestName = document.getElementById('guest-name').value.trim();
          const selectedTour = tourSelect ? tourSelect.value : '';
          showNotification(`🎉 Спасибо, ${guestName}! Заявка на «${selectedTour}» принята.`);
          bookingForm.reset();
        });
      }
    });
  </script>
