<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ASTRODIEDS — Ночные экскурсии </title>
  <meta name="description" content="Экскурсионное бюро ASTRODIED: прогулки по панорамным крышам, разводные мосты с катера, мистические дворы и астрономические туры.">
  
  <!-- OpenGraph для красивого превью в соцсетях и мессенджерах -->
  <meta property="og:title" content="ASTRODIEDS — Магия ночных городов под звёздами">
  <meta property="og:description" content="Крыши, разводные мосты, мистические дворы и телескопы. Малые группы до 10 человек, горячий чай и пледы.">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">

  <!-- Подключение шрифта Montserrat (включая реальное курсивное начертание 800i для логотипа) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,800&display=swap" rel="stylesheet">

  <!-- Локальное SEO: Микроразметка Schema.org -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "name": "ASTRODIEDS",
    "description": "Экскурсионное бюро: ночные прогулки по крышам, разводные мосты и мистические маршруты под звёздным небом.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "-",
      "streetAddress": "Невский проспект, д. 28, офис 402"
    },
    "telephone": "+7-812-555-02-26",
    "email": "hello@astrodieds.ru",
    "openingHours": "Mo-Su 10:00-02:00",
    "priceRange": "1500₽ - 2400₽"
  }
  </script>

  <style>
    /* ==========================================================================
       1. БАЗОВЫЕ ПЕРЕМЕННЫЕ, СБРОС И ПЛАВНЫЙ СКРОЛЛ (ЗАДАЧА 1)
       ========================================================================== */
    :root {
      --bg-white: #FFFFFF;
      --bg-light: #F8F9FD;
      --text-main: #1E1B38;
      --text-muted: #5A567A;
      --indigo-primary: #4C44B5;
      --indigo-dark: #2A247A;
      --indigo-soft: #F0EEFF;
      --accent-gold: #FFD166;
      --header-gradient: linear-gradient(135deg, #4C44B5 0%, #2A247A 100%);
      --card-shadow: 0 10px 30px rgba(30, 27, 56, 0.06);
      --card-shadow-hover: 0 18px 38px rgba(76, 68, 181, 0.22);
      --radius-lg: 20px;
      --radius-md: 12px;
      --header-height: 78px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* Задача 1: Плавная прокрутка для корневого элемента html + отступ под sticky-шапку */
    html {
      scroll-behavior: smooth;
      scroll-padding-top: calc(var(--header-height) + 16px);
    }

    body {
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-white);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ul {
      list-style: none;
    }

    .container {
      width: 100%;
      max-width: 1220px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .section {
      padding: 88px 0;
    }

    .section--alt {
      background-color: var(--bg-light);
    }

    .section__header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 56px;
    }

    .section__eyebrow {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--indigo-primary);
      background: var(--indigo-soft);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 14px;
    }

    .section__title {
      font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin-bottom: 14px;
    }

    .section__subtitle {
      font-size: 1.05rem;
      color: var(--text-muted);
    }

    /* ==========================================================================
       2. ФИКСИРОВАННЫЙ HEADER С ГРАДИЕНТОМ И ВОЛНАМИ
       ========================================================================== */
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      height: var(--header-height);
      background: var(--header-gradient);
      box-shadow: 0 6px 24px rgba(20, 16, 60, 0.28);
      overflow: hidden;
    }

    /* Тонкие светлые полупрозрачные волнообразные линии на фоне шапки */
    .header__waves {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: 0.22;
    }

    .header__inner {
      position: relative;
      z-index: 2;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    /* Логотип: круглая иконка с 4-конечной звездой + жирный наклонный текст ASTRODIEDS */
    .logo {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .logo__icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.14);
      border: 1.5px solid rgba(255, 255, 255, 0.38);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 18px rgba(255, 255, 255, 0.2);
      transition: transform 0.3s ease;
    }

    .logo:hover .logo__icon {
      transform: rotate(15deg) scale(1.05);
    }

    .logo__text {
      color: #FFFFFF;
      font-size: 1.45rem;
      font-weight: 800;
      font-style: italic;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .nav__list {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav__link {
      color: rgba(255, 255, 255, 0.88);
      font-size: 0.94rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 10px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .nav__link:hover,
    .nav__link.active {
      color: #FFFFFF;
      background: rgba(255, 255, 255, 0.14);
    }

    .header__actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cart-indicator {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #FFFFFF;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .cart-indicator:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    .cart-indicator__count {
      background: var(--accent-gold);
      color: var(--text-main);
      font-weight: 800;
      font-size: 0.78rem;
      min-width: 22px;
      height: 22px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 5px;
    }

    .burger-btn {
      display: none;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #FFFFFF;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      cursor: pointer;
      align-items: center;
      justify-content: center;
    }

    /* ==========================================================================
       3. HERO-СЕКЦИЯ
       ========================================================================== */
    .hero {
      position: relative;
      min-height: calc(90vh - var(--header-height));
      display: flex;
      align-items: center;
      background-color: #130F2E;
      background-image: 
        linear-gradient(135deg, rgba(24, 19, 64, 0.86) 0%, rgba(42, 36, 122, 0.72) 55%, rgba(19, 15, 46, 0.9) 100%),
        url('https://images.unsplash.com/photo-1556610961-2fecc5927173?auto=format&fit=crop&w=1600&q=80');
      background-size: cover;
      background-position: center;
      color: #FFFFFF;
      padding: 80px 0 110px;
      overflow: hidden;
    }

    .hero__content {
      position: relative;
      z-index: 2;
      max-width: 780px;
    }

    .hero__badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 0.88rem;
      font-weight: 600;
      margin-bottom: 24px;
      color: #EAE8FF;
    }

    .hero__title {
      font-size: clamp(2.2rem, 4.5vw + 0.8rem, 3.8rem);
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.02em;
      margin-bottom: 22px;
    }

    .hero__title span {
      color: var(--accent-gold);
    }

    .hero__slogan {
      font-size: clamp(1.05rem, 1.5vw + 0.5rem, 1.25rem);
      color: rgba(255, 255, 255, 0.88);
      max-width: 640px;
      margin-bottom: 36px;
    }

    .hero__cta-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 18px;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: linear-gradient(135deg, #6259D8 0%, #4C44B5 100%);
      color: #FFFFFF;
      font-family: inherit;
      font-size: 1.05rem;
      font-weight: 700;
      padding: 16px 34px;
      border-radius: var(--radius-md);
      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow: 0 12px 28px rgba(76, 68, 181, 0.45);
      cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 34px rgba(98, 89, 216, 0.6);
    }

    .hero__micro-trust {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.78);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Плавный волновой разделитель внизу Hero для мягкого перехода к светлому фону */
    .hero__divider {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      line-height: 0;
      z-index: 1;
    }

    .hero__divider svg {
      width: 100%;
      height: 56px;
      display: block;
    }

    /* ==========================================================================
       4. РАЗДЕЛ «О БЮРО ASTRODIEDS»
       ========================================================================== */
    .about__grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 56px;
      align-items: center;
    }

    .about__text p {
      color: var(--text-muted);
      font-size: 1.04rem;
      margin-bottom: 18px;
    }

    .about__stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 32px;
    }

    .stat-box {
      background: var(--bg-light);
      border: 1px solid rgba(76, 68, 181, 0.1);
      padding: 18px;
      border-radius: var(--radius-md);
    }

    .stat-box__num {
      font-size: 1.65rem;
      font-weight: 800;
      color: var(--indigo-primary);
      line-height: 1.1;
      margin-bottom: 4px;
    }

    .stat-box__label {
      font-size: 0.84rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .about__image-wrap {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 20px 45px rgba(30, 27, 56, 0.14);
      aspect-ratio: 4 / 3;
      background: #1E1B38;
    }

    .about__image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .about__floating-badge {
      position: absolute;
      bottom: 20px;
      left: 20px;
      right: 20px;
      background: rgba(30, 27, 56, 0.88);
      backdrop-filter: blur(10px);
      color: #FFFFFF;
      padding: 16px 20px;
      border-radius: var(--radius-md);
      border: 1px solid rgba(255, 255, 255, 0.15);
      font-size: 0.9rem;
    }

    /* ==========================================================================
       5. КАТАЛОГ ЭКСКУРСИЙ И АНИМАЦИЯ .menu-card (ЗАДАЧА 1 И ЗАДАЧА 2)
       ========================================================================== */
    .tours__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 30px;
    }

    /* Задача 1: Карточка .menu-card с плавной анимацией translateY(-6px) и увеличением box-shadow */
    .menu-card {
      display: flex;
      flex-direction: column;
      background-color: var(--bg-white);
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid rgba(76, 68, 181, 0.09);
      box-shadow: var(--card-shadow);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .menu-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--card-shadow-hover);
      border-color: rgba(76, 68, 181, 0.28);
    }

    .tour-card__media {
      position: relative;
      aspect-ratio: 16 / 10;
      background-color: #1E1B38;
      overflow: hidden;
    }

    .tour-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .menu-card:hover .tour-card__media img {
      transform: scale(1.05);
    }

    .tour-card__duration {
      position: absolute;
      top: 14px;
      right: 14px;
      background: rgba(30, 27, 56, 0.82);
      backdrop-filter: blur(6px);
      color: #FFFFFF;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .tour-card__body {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      padding: 24px;
    }

    .tour-card__title {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 10px;
      line-height: 1.35;
    }

    .tour-card__desc {
      font-size: 0.94rem;
      color: var(--text-muted);
      margin-bottom: 22px;
      flex-grow: 1; /* Выравнивает нижнюю часть всех карточек по одной линии */
    }

    .tour-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-top: 18px;
      border-top: 1px solid rgba(30, 27, 56, 0.08);
    }

    .tour-card__price-label {
      display: block;
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .tour-card__price {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--text-main);
    }

    /* Задача 2: Кнопка «В корзину» внутри каждой карточки */
    .add-to-cart-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--indigo-primary);
      color: #FFFFFF;
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 700;
      padding: 12px 20px;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }

    .add-to-cart-btn:hover {
      background: var(--indigo-dark);
      box-shadow: 0 8px 20px rgba(76, 68, 181, 0.3);
    }

    .add-to-cart-btn:active {
      transform: scale(0.97);
    }

    /* ==========================================================================
       6. ПРЕИМУЩЕСТВА (4 КАРТОЧКИ)
       ========================================================================== */
    .advantages__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    .adv-card {
      background: var(--bg-light);
      padding: 30px 24px;
      border-radius: var(--radius-lg);
      border: 1px solid rgba(76, 68, 181, 0.08);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .adv-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--card-shadow);
    }

    .adv-card__icon {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: var(--header-gradient);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 20px;
      box-shadow: 0 8px 18px rgba(76, 68, 181, 0.25);
    }

    .adv-card__title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 10px;
      color: var(--text-main);
    }

    .adv-card__text {
      font-size: 0.92rem;
      color: var(--text-muted);
    }

    /* ==========================================================================
       7. ОТЗЫВЫ ГОСТЕЙ
       ========================================================================== */
    .reviews__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 26px;
    }

    .review-card {
      background: var(--bg-white);
      padding: 28px;
      border-radius: var(--radius-lg);
      box-shadow: var(--card-shadow);
      border: 1px solid rgba(76, 68, 181, 0.08);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .review-card__stars {
      color: #F59E0B;
      font-size: 1.05rem;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .review-card__text {
      font-size: 0.95rem;
      color: var(--text-muted);
      font-style: italic;
      margin-bottom: 20px;
    }

    .review-card__author {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .review-card__avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--indigo-soft);
      color: var(--indigo-primary);
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .review-card__name {
      font-weight: 700;
      font-size: 0.95rem;
    }

    .review-card__tour {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* ==========================================================================
       8. КОНТАКТЫ И ФОРМА БРОНИРОВАНИЯ
       ========================================================================== */
    .contacts__wrapper {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 48px;
      background: var(--bg-light);
      padding: 48px;
      border-radius: 28px;
      border: 1px solid rgba(76, 68, 181, 0.1);
    }

    .contact-list {
      display: flex;
      flex-direction: column;
      gap: 22px;
      margin: 28px 0;
    }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
    }

    .contact-item__icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--indigo-soft);
      color: var(--indigo-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .contact-item__label {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .contact-item__value {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .contact-item__value a:hover {
      color: var(--indigo-primary);
      text-decoration: underline;
    }

    .socials {
      display: flex;
      gap: 12px;
      margin-top: 12px;
    }

    .social-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      border-radius: 10px;
      background: var(--bg-white);
      color: var(--indigo-primary);
      font-weight: 700;
      font-size: 0.9rem;
      border: 1px solid rgba(76, 68, 181, 0.16);
      transition: background 0.2s ease, color 0.2s ease;
    }

    .social-btn:hover {
      background: var(--indigo-primary);
      color: #FFFFFF;
    }

    .booking-form {
      background: var(--bg-white);
      padding: 36px;
      border-radius: var(--radius-lg);
      box-shadow: var(--card-shadow);
    }

    .booking-form__title {
      font-size: 1.35rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .booking-form__sub {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--text-main);
    }

    .form-control {
      width: 100%;
      padding: 13px 16px;
      font-family: inherit;
      font-size: 0.95rem;
      color: var(--text-main);
      background: var(--bg-light);
      border: 1.5px solid rgba(76, 68, 181, 0.16);
      border-radius: 10px;
